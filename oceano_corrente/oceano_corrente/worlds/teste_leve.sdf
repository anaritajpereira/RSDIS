<?xml version="1.0" ?>
<!--
  MUNDO DE TESTE LEVE: só o mar, a plataforma e um barco, sem sistemas de sensores.
  Serve para diagnosticar o que está a pesar no portátil.
  - Dois barcos (Vessel A e Vessel B) que flutuam nas ondas e derivam com a corrente.
  - Uma plataforma fixa na origem para o drone descolar (o drone é lançado à parte).

  A corrente é controlada pelo tópico /ocean_current (ignition.msgs.Vector3d, em m/s,
  no referencial do mundo). Começa com o valor de <default_current> de cada barco.
-->
<sdf version="1.9">
  <world name="teste_leve">

    <!-- ===================== Física e sistemas do mundo ===================== -->
    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <!-- ===================== Cena e luz ===================== -->
    <scene>
      <sky></sky>
      <grid>false</grid>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <light type="directional" name="sol">
      <cast_shadows>false</cast_shadows>  <!-- sombras desligadas: pesadas em gráficas integradas -->
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===================== Mar ===================== -->
    <!-- Só a parte visual das ondas (modelo do MBZIRC, 1000 x 1000 m).
         A física da água não está aqui: está nos plugins de cada barco. -->
    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>waves</uri>
    </include>

    <!-- ===================== Plataforma de descolagem do drone ===================== -->
    <!-- O topo fica em z = 1.0 m. Sem ela o drone cairia: a água não tem colisão. -->
    <model name="plataforma">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 6 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 6 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Barco 1: Vessel A (6 m) ===================== -->
    <include>
      <name>barco_1</name>
      <pose>30 10 0.3 0 0 -1.0</pose>
      <uri>https://fuel.ignitionrobotics.org/1.0/openrobotics/models/Vessel A</uri>

      <!-- Flutuação nas ondas (plugin do MBZIRC). Os parâmetros da onda têm de
           coincidir com os do modelo "waves" para o barco seguir a água que se vê. -->
      <plugin filename="libSurface.so"
              name="ignition::gazebo::systems::Surface">
        <link_name>link</link_name>
        <vehicle_length>6</vehicle_length>
        <vehicle_width>3.3</vehicle_width>
        <hull_radius>1.9</hull_radius>
        <fluid_level>0.45</fluid_level>
        <wavefield>
          <size>1000 1000</size>
          <cell_count>50 50</cell_count>
          <wave>
            <model>PMS</model>
            <period>5</period>
            <number>3</number>
            <scale>1.1</scale>
            <gain>0.3</gain>
            <direction>1 0</direction>
            <angle>0.4</angle>
            <tau>2.0</tau>
            <amplitude>0.0</amplitude>
            <steepness>0.0</steepness>
          </wave>
        </wavefield>
      </plugin>

      <!-- Arrasto da água + corrente (plugin nativo do Gazebo).
           Substitui o SimpleHydrodynamics do MBZIRC, que não suporta corrente.
           Coeficientes NEGATIVOS: força = coef * velocidade_relativa, e o arrasto
           tem de se opor ao movimento relativo à água. -->
      <plugin filename="ignition-gazebo-hydrodynamics-system"
              name="ignition::gazebo::systems::Hydrodynamics">
        <link_name>link</link_name>
        <!-- linear (N por m/s) -->
        <xU>-510.3</xU>
        <yV>-400.0</yV>
        <zW>-5000.0</zW>
        <kP>-500.0</kP>
        <mQ>-500.0</mQ>
        <nR>-15000.0</nR>
        <!-- quadrático (N por (m/s)^2), só em x -->
        <xUabsU>-720.4</xUabsU>
        <!-- corrente inicial em m/s (x, y, z no mundo) -->
        <default_current>0.5 0 0</default_current>
      </plugin>
    </include>

  </world>
</sdf>
