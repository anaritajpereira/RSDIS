<?xml version="1.0" ?>
<!--
  Oceano com ondas e corrente, para usar com o simulador MBZIRC (Ignition Fortress).
  - barco_1: WAM-V com dois motores (comandável), na cor original.
  - barco_2: Vessel B, sem motor, com um painel VERMELHO no convés (é o alvo).
  - Os dois flutuam nas ondas e derivam com a corrente.
  - Uma plataforma fixa na origem para o drone descolar (o drone é lançado à parte).

  A corrente é controlada pelo tópico /ocean_current (ignition.msgs.Vector3d, em m/s,
  no referencial do mundo). Começa com o valor de <default_current> de cada barco.
-->
<sdf version="1.9">
  <world name="oceano_corrente">

    <!-- ===================== Física e sistemas do mundo ===================== -->
    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <!-- Sistemas de que os sensores do drone precisam (câmaras, IMU, etc.) -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-magnetometer-system"
            name="ignition::gazebo::systems::Magnetometer"/>
    <plugin filename="ignition-gazebo-altimeter-system"
            name="ignition::gazebo::systems::Altimeter"/>
    <plugin filename="ignition-gazebo-air-pressure-system"
            name="ignition::gazebo::systems::AirPressure"/>

    <!-- ===================== Cena e luz ===================== -->
    <scene>
      <sky></sky>
      <grid>false</grid>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <light type="directional" name="sol">
      <cast_shadows>false</cast_shadows>  <!-- sombras desligadas: pesadas em gráficas integradas -->
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===================== Mar ===================== -->
    <!-- Só a parte visual das ondas (modelo do MBZIRC, 1000 x 1000 m).
         A física da água não está aqui: está nos plugins de cada barco. -->
    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>waves</uri>
    </include>

    <!-- ===================== Plataforma de descolagem do drone ===================== -->
    <!-- O topo fica em z = 1.0 m. Sem ela o drone cairia: a água não tem colisão. -->
    <model name="plataforma">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 6 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 6 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Barco 1: WAM-V com motores ===================== -->
    <!-- Modelo definido em models/barco_motor (casco do MBZIRC + 2 motores +
         flutuação + arrasto com corrente). Comanda-se com scripts/barco_teleop.py. -->
    <include>
      <name>barco_1</name>
      <pose>15 10 0.3 0 0 0</pose>
      <uri>barco_motor</uri>
    </include>

    <!-- ===================== Barco 2: Vessel B (22 m) ===================== -->
    <include>
      <name>barco_2</name>
      <pose>-40 -30 0.4 0 0 0.5</pose>
      <uri>https://fuel.ignitionrobotics.org/1.0/openrobotics/models/Vessel B</uri>

      <plugin filename="libSurface.so"
              name="ignition::gazebo::systems::Surface">
        <link_name>link</link_name>
        <vehicle_length>22</vehicle_length>
        <vehicle_width>7</vehicle_width>
        <hull_radius>3.5</hull_radius>
        <fluid_level>0.45</fluid_level>
        <wavefield>
          <size>1000 1000</size>
          <cell_count>50 50</cell_count>
          <wave>
            <model>PMS</model>
            <period>5</period>
            <number>3</number>
            <scale>1.1</scale>
            <gain>0.3</gain>
            <direction>1 0</direction>
            <angle>0.4</angle>
            <tau>2.0</tau>
            <amplitude>0.0</amplitude>
            <steepness>0.0</steepness>
          </wave>
        </wavefield>
      </plugin>

      <plugin filename="ignition-gazebo-hydrodynamics-system"
              name="ignition::gazebo::systems::Hydrodynamics">
        <link_name>link</link_name>
        <xU>-1020.0</xU>
        <yV>-400.0</yV>
        <zW>-5000.0</zW>
        <kP>-500.0</kP>
        <mQ>-500.0</mQ>
        <nR>-15000.0</nR>
        <xUabsU>-1450.0</xUabsU>
        <default_current>0.5 0 0</default_current>
      </plugin>
    </include>

    <!-- ===================== Marca vermelha no barco_2 (o alvo) ===================== -->
    <!-- O Vessel B vem do Fuel e não dá para mudar a cor de um modelo incluído.
         Por isso pomos um painel vermelho no convés e prendemo-lo ao barco com o
         DetachableJoint (a mesma técnica que o MBZIRC usa para pôr caixas nos barcos).
         O painel é plano e grande para ser bem visível de cima, pela câmara do drone. -->
    <model name="marca_vermelha">
      <pose relative_to="barco_2">0 0 0.8 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>20</mass>
          <inertia>
            <ixx>27</ixx><iyy>107</iyy><izz>133</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- Sem <collision>: o painel é só visual e não choca com o convés. -->
        <visual name="visual">
          <geometry><box><size>8 4 0.1</size></box></geometry>
          <material>
            <ambient>0.8 0 0 1</ambient>
            <diffuse>0.8 0 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <!-- Prende este painel (parent) ao link do barco_2 (child) com uma junta fixa. -->
      <plugin filename="ignition-gazebo-detachable-joint-system"
              name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>barco_2</child_model>
        <child_link>link</child_link>
        <topic>/barco_2/soltar_marca</topic>
      </plugin>
    </model>

  </world>
</sdf>
